            <part name="d-18_pat12.bin" crc="a429b237" offset="0x40000" length="0x20000" map="01"/>
            <part name="d-17_pat02.bin" crc="addc5261" offset="0x40000" length="0x20000" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="d-19_pat13.bin" crc="af2507ce" offset="0x0" length="0x20000" map="01"/>
            <part name="d-18_pat03.bin" crc="36b9c407" offset="0x0" length="0x20000" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="d-19_pat13.bin" crc="af2507ce" offset="0x40000" length="0x20000" map="01"/>
            <part name="d-18_pat03.bin" crc="36b9c407" offset="0x40000" length="0x20000" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="d-16_u41.bin" crc="ff5ea605" offset="0x20000" length="0x20000" map="01"/>
            <part name="d-15_u42.bin" crc="5f72d6cc" offset="0x20000" length="0x20000" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="d-16_u41.bin" crc="ff5ea605" offset="0x60000" length="0x20000" map="01"/>
            <part name="d-15_u42.bin" crc="5f72d6cc" offset="0x60000" length="0x20000" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="d-17_pat11.bin" crc="2facb3f1" offset="0x20000" length="0x20000" map="01"/>
            <part name="d-20_pat01.bin" crc="cc4d3b49" offset="0x20000" length="0x20000" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="d-17_pat11.bin" crc="2facb3f1" offset="0x60000" length="0x20000" map="01"/>
            <part name="d-20_pat01.bin" crc="cc4d3b49" offset="0x60000" length="0x20000" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="d-18_pat12.bin" crc="a429b237" offset="0x20000" length="0x20000" map="01"/>
            <part name="d-17_pat02.bin" crc="addc5261" offset="0x20000" length="0x20000" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="d-18_pat12.bin" crc="a429b237" offset="0x60000" length="0x20000" map="01"/>
            <part name="d-17_pat02.bin" crc="addc5261" offset="0x60000" length="0x20000" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="d-19_pat13.bin" crc="af2507ce" offset="0x20000" length="0x20000" map="01"/>
            <part name="d-18_pat03.bin" crc="36b9c407" offset="0x20000" length="0x20000" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="d-19_pat13.bin" crc="af2507ce" offset="0x60000" length="0x20000" map="01"/>
            <part name="d-18_pat03.bin" crc="36b9c407" offset="0x60000" length="0x20000" map="10"/>
        </interleave>
        <!-- sprites: first half at 0x500000, second half at 0x600000 -->
        <interleave output="16">
            <part name="d-17_u53.bin" crc="4d177bda" offset="0x0" length="0x80000" map="01"/>
            <part name="d-18_u54.bin" crc="218c4471" offset="0x0" length="0x80000" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="d-19_u55.bin" crc="59507521" offset="0x0" length="0x80000" map="01"/>
            <part name="d-20_u56.bin" crc="e67c2c7d" offset="0x0" length="0x80000" map="10"/>
        </interleave>
        <!-- oki: the M6295 samples -->
        <part name="d-12_uz1.bin" crc="a170d8a9" offset="0x0" length="0x40000"/>
        <!-- audiocpu: the Z80 program (64 KB) -->
        <part name="d-11_uz02.bin" crc="b41289e6" offset="0x0" length="0x10000"/>
        <!-- configuration: PuzzLove sprite format, 32768 tiles, sound clocks, vertical, button 3 -->
        <part>00 01 00 01 00 00 00 00</part>
    </rom>

    <buttons names="Shot,Bomb,-,Start,Coin" default="A,B,Start,Select"/>
</misterromdescription>
